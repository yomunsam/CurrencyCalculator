@inject IJSRuntime JS
@implements IAsyncDisposable

@{ var groups = CurrencySelection.GetGroups(Items, RecentCodes, CurrentLanguage, _query); }

<dialog class="currency-selector" @ref="_dialog" aria-labelledby="currency-selector-title">
    <div class="selector-header">
        <h2 id="currency-selector-title">@Localize("SelectCurrency")</h2>
        <button class="selector-close" @onclick="OnClose" aria-label="@Localize("Close")">×</button>
    </div>
    <div class="selector-search">
        <input type="search" @bind="_query" @bind:event="oninput"
               placeholder="@Localize("SearchCurrencies")" aria-label="@Localize("SearchCurrencies")"
               autocomplete="off" spellcheck="false" />
    </div>
    <div class="selector-results">
        @if (Items.Count == 0)
        {
            <p class="selector-empty" role="status">@Localize("NoMoreCurrencies")</p>
        }
        else if (groups.All(group => group.Items.Count == 0))
        {
            <p class="selector-empty" role="status">@Localize("NoCurrencyResults")</p>
        }
        else
        {
            @foreach (var group in groups.Where(group => group.Items.Count > 0))
            {
                <section aria-label="@Localize(group.Title)">
                    <h3>@Localize(group.Title)</h3>
                    @foreach (var item in group.Items)
                    {
                        <button class="selector-item" @key="item.Code" @onclick="() => OnSelect.InvokeAsync(item.Code)">
                            @if (!HideCurrencyIcons)
                            {
                                @if (item.Kind == CurrencyKind.Fiat)
                                {
                                    <img src="img/fiat_icons/@(item.Icon).svg" alt="" loading="lazy" />
                                }
                                else
                                {
                                    <span class="selector-symbol" aria-hidden="true">@item.Icon</span>
                                }
                            }
                            <span class="selector-code">@item.Code</span>
                            <span class="selector-name">@item.GetName(CurrentLanguage)</span>
                        </button>
                    }
                </section>
            }
        }
    </div>
</dialog>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool HideCurrencyIcons { get; set; }
    [Parameter] public string CurrentLanguage { get; set; } = "en-US";
    [Parameter] public IReadOnlyList<CurrencyDefinition> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<string> RecentCodes { get; set; } = [];
    [Parameter, EditorRequired] public Func<string, string> Localize { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private ElementReference _dialog;
    private IJSObjectReference? _module;
    private DotNetObjectReference<CurrencySelectorOverlay>? _reference;
    private bool _wasOpen;
    private bool _shown;
    private string _query = "";


    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen)
        {
            _query = "";
        }
        _wasOpen = IsOpen;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_module is null && IsOpen)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/currency-selector.js");
            _reference = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initialize", _dialog, _reference);
        }
        if (_module is not null && IsOpen != _shown)
        {
            _shown = IsOpen;
            await _module.InvokeVoidAsync(IsOpen ? "open" : "close", _dialog);
        }
    }

    [JSInvokable]
    public Task DismissAsync() => OnClose.InvokeAsync();

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _dialog);
            await _module.DisposeAsync();
        }
        _reference?.Dispose();
    }
}

