@{ var groups = CurrencySelection.GetGroups(Items, RecentCodes, CurrentLanguage, _query); }

<AdaptivePanel IsOpen="IsOpen" Title="@Localize("SelectCurrency")" CloseLabel="@Localize("Close")" OnClose="OnClose">
    <div class="selector-search">
        <input type="search" @bind="_query" @bind:event="oninput"
               placeholder="@Localize("SearchCurrencies")" aria-label="@Localize("SearchCurrencies")"
               autocomplete="off" spellcheck="false" />
    </div>
    <div class="selector-results">
        @if (Items.Count == 0)
        {
            <p class="selector-empty" role="status">@Localize("NoMoreCurrencies")</p>
        }
        else if (groups.All(group => group.Items.Count == 0))
        {
            <p class="selector-empty" role="status">@Localize("NoCurrencyResults")</p>
        }
        else
        {
            @foreach (var group in groups.Where(group => group.Items.Count > 0))
            {
                <section aria-label="@Localize(group.Title)">
                    <h3>@Localize(group.Title)</h3>
                    @foreach (var item in group.Items)
                    {
                        <button class="selector-item" @key="item.Code" @onclick="() => OnSelect.InvokeAsync(item.Code)">
                            @if (!HideCurrencyIcons)
                            {
                                @if (item.Kind == CurrencyKind.Fiat)
                                {
                                    <img src="img/fiat_icons/@(item.Icon).svg" alt="" loading="lazy" draggable="false" />
                                }
                                else
                                {
                                    <span class="selector-symbol" aria-hidden="true">@item.Icon</span>
                                }
                            }
                            <span class="selector-description"><span class="selector-code">@item.Code</span><span class="selector-name">@item.GetName(CurrentLanguage)</span></span>
                        </button>
                    }
                </section>
            }
        }
    </div>
</AdaptivePanel>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool HideCurrencyIcons { get; set; }
    [Parameter] public string CurrentLanguage { get; set; } = "en-US";
    [Parameter] public IReadOnlyList<CurrencyDefinition> Items { get; set; } = [];
    [Parameter] public IReadOnlyList<string> RecentCodes { get; set; } = [];
    [Parameter, EditorRequired] public Func<string, string> Localize { get; set; } = default!;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnSelect { get; set; }

    private bool _wasOpen;
    private string _query = "";
    protected override void OnParametersSet()
    {
        if (IsOpen && !_wasOpen) _query = "";
        _wasOpen = IsOpen;
    }
}
