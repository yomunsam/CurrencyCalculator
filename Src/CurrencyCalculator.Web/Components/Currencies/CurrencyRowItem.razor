@inject IJSRuntime JS

<div class="cc-row-shell" data-can-remove="@CanRemove.ToString().ToLowerInvariant()">
    <button class="row-swipe-delete" @onclick="OnRemove" disabled="@(!CanRemove)" tabindex="-1" aria-hidden="true">
        @RemoveTitle
    </button>
    <div class="cc-row @(IsActive ? "is-active" : "")" @onclick="OnSetActive">
        <button class="row-drag-handle" title="@Localize("RowActions")" aria-label="@(Currency.Code + " " + Localize("RowActions"))"
                aria-haspopup="menu" aria-controls="@_menuId" @onclick:stopPropagation="true">
            <i class="bi bi-grip-vertical" aria-hidden="true"></i>
        </button>
        @if (!HideCurrencyIcons)
        {
            @if (Currency.Kind == CurrencyKind.Fiat)
            {
                <img class="currency-flag" src="img/fiat_icons/@(Currency.Icon).svg"
                     alt="" loading="lazy" draggable="false" />
            }
            else
            {
                <img class="currency-icon-crypto" src="img/crypto_icons/@(Currency.Icon).svg"
                     alt="" loading="lazy" draggable="false" />
            }
        }

        <div class="currency-info">
            <button class="currency-code" aria-haspopup="dialog" aria-label="@(Localize("SelectCurrency") + ": " + Currency.Code)" @onclick="OnOpenSelector" @onclick:stopPropagation="true">
                @Currency.Code <i class="bi bi-chevron-down" aria-hidden="true"></i>
            </button>
            <span class="currency-name">@Currency.GetName(CurrentLanguage)</span>
        </div>

        @if (Currency.Kind == CurrencyKind.Crypto)
        {
            @if (IsCryptoStale)
            {
                <i class="bi bi-exclamation-triangle-fill crypto-warn-stale"
                   @onclick="() => OnShowCryptoWarning.InvokeAsync(true)" @onclick:stopPropagation="true"></i>
            }
            else
            {
                <i class="bi bi-exclamation-circle-fill crypto-warn-volatile"
                   @onclick="() => OnShowCryptoWarning.InvokeAsync(false)" @onclick:stopPropagation="true"></i>
            }
        }

        <div class="amount-area">
            @if (IsActive)
            {
                <input class="amount-input" type="text" inputmode="none" @ref="_inputRef"
                       style="--amount-characters: @(Math.Max(3, DisplayAmount.Length + 1))"
                       value="@DisplayAmount" placeholder="0" autocomplete="off" spellcheck="false"
                       aria-label="@(Currency.Code + " " + Localize("Amount"))"
                       @onfocus="HandleFocus" @oninput="OnInput" @onkeydown="HandleKeyDown" />
            }
            else
            {
                <button class="amount-label" @onclick="ActivateAmount" @onclick:stopPropagation="true"
                        aria-label="@(Currency.Code + " " + Localize("Amount"))">@(string.IsNullOrEmpty(DisplayAmount) ? "0" : DisplayAmount)</button>
            }
        </div>

        <button class="row-btn row-clear @(!IsActive ? "is-hidden" : "")" disabled="@(!IsActive)"
                @onclick="OnClear" @onclick:stopPropagation="true" title="@ClearTitle" aria-label="@(Currency.Code + " " + ClearTitle)">
            <i class="bi bi-eraser" aria-hidden="true"></i>
        </button>
    </div>
    <div id="@_menuId" class="row-menu" popover="manual" role="menu" aria-label="@(Currency.Code + " " + Localize("RowActions"))">
        <button role="menuitem" class="row-copy" disabled="@(!CanCopy)" data-copy-value="@CopyValue"
                data-copy-success="@Localize("CopySuccess")" data-copy-failed="@Localize("CopyFailed")">@Localize("CopyValue")</button>
        <button role="menuitem" @onclick="() => OnMove.InvokeAsync(-1)" disabled="@(!CanMoveUp)">@Localize("MoveUp")</button>
        <button role="menuitem" @onclick="() => OnMove.InvokeAsync(1)" disabled="@(!CanMoveDown)">@Localize("MoveDown")</button>
        <button role="menuitem" class="row-menu-delete" @onclick="OnRemove" disabled="@(!CanRemove)">@RemoveTitle</button>
    </div>
</div>

@code {
    private readonly string _menuId = "row-menu-" + Guid.NewGuid().ToString("N");
    private ElementReference _inputRef;
    private bool _pendingCursorToEnd;

    [Parameter, EditorRequired] public CurrencyDefinition Currency { get; set; } = default!;
    [Parameter, EditorRequired] public string CurrentLanguage { get; set; } = "en-US";
    [Parameter, EditorRequired] public string DisplayAmount { get; set; } = "";
    [Parameter, EditorRequired] public string CopyValue { get; set; } = "";
    [Parameter, EditorRequired] public string ClearTitle { get; set; } = "Clear";
    [Parameter, EditorRequired] public string RemoveTitle { get; set; } = "Remove";
    [Parameter] public bool IsActive { get; set; }
    [Parameter] public bool CanCopy { get; set; } = true;
    [Parameter] public bool CanRemove { get; set; }
    [Parameter] public bool IsCryptoStale { get; set; }

    [Parameter] public bool HideCurrencyIcons { get; set; }


    [Parameter, EditorRequired] public EventCallback OnSetActive { get; set; }
    [Parameter, EditorRequired] public EventCallback OnOpenSelector { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> OnShowCryptoWarning { get; set; }
    [Parameter, EditorRequired] public EventCallback OnFocus { get; set; }
    [Parameter] public EventCallback OnCommit { get; set; }
    [Parameter, EditorRequired] public EventCallback<ChangeEventArgs> OnInput { get; set; }
    [Parameter, EditorRequired] public EventCallback OnClear { get; set; }
    [Parameter, EditorRequired] public EventCallback OnRemove { get; set; }
    [Parameter, EditorRequired] public Func<string, string> Localize { get; set; } = default!;
    [Parameter] public bool CanMoveUp { get; set; }
    [Parameter] public bool CanMoveDown { get; set; }
    [Parameter] public EventCallback<int> OnMove { get; set; }
    private Task HandleFocus() => OnFocus.InvokeAsync();

    private async Task ActivateAmount()
    {
        await OnSetActive.InvokeAsync();
        await OnFocus.InvokeAsync();
        _pendingCursorToEnd = true;
    }

    private Task HandleKeyDown(KeyboardEventArgs args) =>
        args.Key == "Enter" ? OnCommit.InvokeAsync() : Task.CompletedTask;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_pendingCursorToEnd || !IsActive) return;
        _pendingCursorToEnd = false;
        await using var module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/amount-editor.js");
        await module.InvokeVoidAsync("focusAmount", _inputRef);
    }
}
