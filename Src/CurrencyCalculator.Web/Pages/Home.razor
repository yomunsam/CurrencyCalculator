@page "/"
@inject ExchangeRateService ExchangeRateService
@inject LocalizationService LocalizationService
@inject BrowserStorageService BrowserStorageService
@inject BrowserContextService BrowserContextService
@inject IJSRuntime JS

<PageTitle>@L("AppTitle")</PageTitle>

<header class="app-header">
    <button class="header-btn" @onclick="OpenSettings" title="@L("Settings")" aria-label="@L("Settings")"><i class="bi bi-gear"></i></button>
    <span class="header-title">@L("AppTitle")</span>
    <div class="header-actions">
        <button class="header-btn" @onclick="ToggleThemeAsync" title="@L("ToggleTheme")" aria-label="@L("ToggleTheme")"><i class="bi @(IsDarkMode ? "bi-sun" : "bi-moon")"></i></button>
        <button class="header-btn @(IsRefreshing ? "refreshing" : "")" @onclick="RefreshRatesAsync" disabled="@IsLoading" title="@L("Refresh")" aria-label="@L("Refresh")"><i class="bi bi-arrow-clockwise"></i></button>
    </div>
</header>
<div class="comparison-column">
    <p class="app-subtitle" role="status">@(LatestSnapshot is null ? L(IsLoading ? "LoadingRates" : "Unavailable") : GetSourceLabel())</p>

    @if (IsLoading)
    {
        <div class="cc-loading-state mb-2" role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <span>@L("LoadingRates")</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(ErrorMessage))
    {
        <div class="alert alert-warning py-2 px-3" style="font-size:.85rem;" role="alert">@ErrorMessage</div>
    }

    <CurrencyComparisonList @ref="_comparisonList" OnReorder="ReorderItemsAsync">
        @for (var i = 0; i < CompareItems.Count; i++)
        {
            var row = CompareItems[i];
            var rowIndex = i;
            var currency = CurrencyCatalog.GetByCode(row.CurrencyCode);

            <CurrencyRowItem @key="row"
                Currency="currency"
                CurrentLanguage="@CurrentLanguage"
                DisplayAmount="@GetDisplayAmount(row, currency)"
                CopyValue="@row.Amount.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture)"
                IsActive="rowIndex == ActiveIndex"
                CanCopy="@(rowIndex == ActiveIndex || IsConversionAvailable(row))"
                CanRemove="CompareItems.Count > AppSettings.MinCompareItems"
                IsCryptoStale="IsCryptoStale(currency)"
                HideCurrencyIcons="HideCurrencyIcons"
                OnSetActive="() => SetActiveIndex(rowIndex)"
                OnOpenSelector="() => OpenSelector(rowIndex)"
                OnShowCryptoWarning="ShowCryptoWarning"
                OnFocus="() => OnRowFocus(rowIndex)"
                OnCommit="() => CommitAmountAsync(rowIndex)"
                OnInput="eventArgs => OnAmountInputAsync(rowIndex, eventArgs)"
                OnClear="() => ClearAmountAsync(rowIndex)"
                OnRemove="() => RemoveItemAsync(rowIndex)"
                ClearTitle="@L("Clear")"
                RemoveTitle="@L("Remove")"
                Localize="L"
                CanMoveUp="@(rowIndex > 0)"
                CanMoveDown="@(rowIndex < CompareItems.Count - 1)"
                OnMove="offset => ReorderItemsAsync((rowIndex, rowIndex + offset))" />
        }

        <button class="cc-add-row" @onclick="AddItemAsync"
                disabled="@(CompareItems.Count >= AppSettings.MaxCompareItems)">
            <i class="bi bi-plus-lg"></i> <span>@L("AddItem")</span>
        </button>
    </CurrencyComparisonList>

    <div class="cc-ad-slot cc-ad-bottom d-none" aria-hidden="true"></div>

    <footer class="cc-footer mt-3 mb-2">
        @if (LatestSnapshot is not null)
        {
            var isGlobalStale = IsGlobalStale();
            <div class="cc-footer-info">
                <span>@L("RateSource"): <b>@GetSourceLabel()</b></span>
                <span class="mx-1">·</span>
                <span class="@(isGlobalStale ? "stale fw-semibold" : "")">
                    @L("UpdatedAt"): @LatestSnapshot.FetchedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </span>
            </div>
            @if (isGlobalStale)
            {
                <div class="cc-footer-info stale">@L("StaleWarning")</div>
            }
        }

    </footer>
</div>

<CalculatorKeyboard NeverUse="NeverUseKeyboard" Localize="L" />

<CurrencySelectorOverlay
    IsOpen="SelectorOpen"
    CurrentLanguage="@CurrentLanguage"
    HideCurrencyIcons="HideCurrencyIcons"
    Items="GetSelectableCurrencies()"
    RecentCodes="RecentSelectorCodes"
    Localize="L"
    OnClose="CloseSelector"
    OnSelect="SelectCurrencyAsync" />

<AboutModal IsOpen="ShowAbout" Localize="L" OnClose="CloseAbout" />
<SettingsModal IsOpen="ShowSettings" IgnoreFiatDecimals="IgnoreFiatDecimals"
               HideCurrencyIcons="HideCurrencyIcons" IsChinaTimezone="IsChinaTimezone"
               Localize="L" OnClose="CloseSettings"
               CurrentLanguage="@CurrentLanguage" OnLanguageChanged="SwitchLanguageAsync"
               NeverUseKeyboard="NeverUseKeyboard" OnNeverUseKeyboardChanged="OnNeverUseKeyboardChangedAsync"
               OnAbout="OpenAbout"
               OnIgnoreFiatDecimalsChanged="OnIgnoreFiatDecimalsChangedAsync"
               OnHideCurrencyIconsChanged="OnHideCurrencyIconsChangedAsync" />
<CryptoWarningModal IsOpen="ShowCryptoModal" Message="@CryptoModalMessage" OnClose="CloseCryptoModal" />

@code {
    private CurrencyComparisonList? _comparisonList;
    private int? _focusAfterRemoval;
    private string CurrentLanguage { get; set; } = "en-US";
    private List<CompareItemState> CompareItems { get; set; } = [];
    private ExchangeRatesSnapshot? LatestSnapshot { get; set; }
    private int ActiveIndex { get; set; }
    private bool IsLoading { get; set; } = true;
    private bool IsRefreshing { get; set; }
    private string? ErrorMessage { get; set; }
    private bool IsDarkMode { get; set; }
    private bool ShowAbout { get; set; }
    private bool ShowSettings { get; set; }
    private bool NeverUseKeyboard { get; set; }
    private bool ShowCryptoModal { get; set; }
    private string CryptoModalMessage { get; set; } = "";
    private bool SelectorOpen { get; set; }
    private int SelectorTargetIndex { get; set; }
    private int? EditingRowIndex { get; set; }
    private string? RawEditingInput { get; set; }
    private List<string> RecentSelectorCodes { get; set; } = [];
    private bool IgnoreFiatDecimals { get; set; }
    private bool HideCurrencyIcons { get; set; }
    private bool IsChinaTimezone { get; set; }

    protected override async Task OnInitializedAsync()
    {
        CurrentLanguage = await LocalizationService.InitializeLanguageAsync();
        IsDarkMode = await JS.InvokeAsync<bool>("ccTheme.isDark");
        NeverUseKeyboard = await BrowserStorageService.GetAsync<bool>(AppSettings.NeverUseKeyboardStorageKey);
        IgnoreFiatDecimals = await BrowserStorageService.GetAsync<bool>(AppSettings.IgnoreFiatDecimalsStorageKey);

        var timezone = await BrowserContextService.GetTimezoneAsync();
        IsChinaTimezone = timezone.StartsWith("Asia/Shanghai", StringComparison.OrdinalIgnoreCase)
                       || timezone.StartsWith("Asia/Urumqi", StringComparison.OrdinalIgnoreCase);
        var storedHideIcons = await BrowserStorageService.GetAsync<bool?>(AppSettings.HideCurrencyIconsStorageKey);
        HideCurrencyIcons = storedHideIcons ?? IsChinaTimezone;

        await LoadRecentSelectorCodesAsync();

        var preferences = await BrowserStorageService.GetAsync<UserPreferences>(AppSettings.PreferencesStorageKey);
        if (preferences is { Items.Count: > 0 })
        {
            CurrentLanguage = LocalizationService.Normalize(preferences.Language);
            CompareItems = EnsureValidCompareItems(preferences.Items);
            ActiveIndex = Math.Clamp(preferences.ActiveIndex, 0, CompareItems.Count - 1);
        }
        else
        {
            CompareItems = BuildDefaultItems(CurrentLanguage);
            ActiveIndex = 0;
        }

        LatestSnapshot = await ExchangeRateService.GetAvailableAsync();
        RecalculateFromActive();
        StateHasChanged();
        await LoadRatesAsync(forceRefresh: true);
        RecalculateFromActive();
        await SavePreferencesAsync();
    }

    private async Task RefreshRatesAsync()
    {
        IsRefreshing = true;
        StateHasChanged();
        await LoadRatesAsync(forceRefresh: true);
        RecalculateFromActive();
        await SavePreferencesAsync();

        if (string.IsNullOrWhiteSpace(ErrorMessage))
            await JS.InvokeVoidAsync("ccToast.show", L(LatestSnapshot?.SourceKind == ExchangeRatesSourceKind.LiveApi ? "RefreshSuccess" : "RefreshUsingSaved"), 2000);
        else
            await JS.InvokeVoidAsync("ccToast.show", L("RefreshFailed"), 3000);

        _ = Task.Delay(600).ContinueWith(_ =>
        {
            IsRefreshing = false;
            InvokeAsync(StateHasChanged);
        });
    }

    private async Task LoadRatesAsync(bool forceRefresh)
    {
        IsLoading = true;
        ErrorMessage = null;
        try
        {
            LatestSnapshot = await ExchangeRateService.GetLatestAsync(forceRefresh);
        }
        catch
        {
            ErrorMessage = L("LoadFailed");
        }
        finally
        {
            IsLoading = false;
        }
    }

    private void OnRowFocus(int index)
    {
        ShowSettings = false;
        SelectorOpen = false;
        ShowAbout = false;
        if (EditingRowIndex == index) return;
        SetActiveIndex(index);
        EditingRowIndex = index;
        RawEditingInput = FormatAmountRaw(CompareItems[index].Amount, CurrencyCatalog.GetByCode(CompareItems[index].CurrencyCode));
    }

    private void SetActiveIndex(int index)
    {
        if (ActiveIndex == index) return;
        EditingRowIndex = null;
        RawEditingInput = null;
        ActiveIndex = Math.Clamp(index, 0, CompareItems.Count - 1);
        RecalculateFromActive();
    }

    private async Task OnAmountInputAsync(int index, ChangeEventArgs eventArgs)
    {
        var raw = eventArgs.Value?.ToString() ?? "";
        EditingRowIndex = index;
        RawEditingInput = raw;

        var amount = 0m;
        if (!string.IsNullOrWhiteSpace(raw) && !TryParseAmount(raw, out amount))
            return;

        ActiveIndex = Math.Clamp(index, 0, CompareItems.Count - 1);
        CompareItems[index].Amount = amount;
        RecalculateFromActive();
        await SavePreferencesAsync();
    }

    private async Task CommitAmountAsync(int index)
    {
        if (EditingRowIndex != index) return;
        var expression = string.IsNullOrWhiteSpace(RawEditingInput) ? "0" : RawEditingInput;
        if (!MathExpressionEvaluator.TryEvaluate(expression, out var result))
        {
            await JS.InvokeVoidAsync("ccToast.show", L("InvalidExpression"), 2000);
            return;
        }
        CompareItems[index].Amount = result;
        RawEditingInput = result.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture);
        RecalculateFromActive();
        await SavePreferencesAsync();
    }

    private async Task ClearAmountAsync(int index)
    {
        SetActiveIndex(index);
        CompareItems[index].Amount = 0m;
        RawEditingInput = EditingRowIndex == index ? "" : null;
        RecalculateFromActive();
        await SavePreferencesAsync();
    }

    private void OpenSelector(int index)
    {
        ShowSettings = false;
        SelectorTargetIndex = index;
        SelectorOpen = true;
    }

    private void CloseSelector() => SelectorOpen = false;

    private async Task SelectCurrencyAsync(string code)
    {
        SelectorOpen = false;
        CompareItems[SelectorTargetIndex].CurrencyCode = code;
        UpdateRecentSelectorCodes(code);
        RecalculateFromActive();
        await Task.WhenAll(SaveRecentSelectorCodesAsync(), SavePreferencesAsync());
    }

    private async Task AddItemAsync()
    {
        if (CompareItems.Count >= AppSettings.MaxCompareItems) return;
        var nextCurrency = CurrencyCatalog.Items
            .Select(item => item.Code)
            .FirstOrDefault(code => CompareItems.All(e => !e.CurrencyCode.Equals(code, StringComparison.OrdinalIgnoreCase)))
            ?? "USD";
        CompareItems.Add(new CompareItemState { CurrencyCode = nextCurrency, Amount = 0m });
        RecalculateFromActive();
        await SavePreferencesAsync();
    }

    private async Task RemoveItemAsync(int index)
    {
        if (CompareItems.Count <= AppSettings.MinCompareItems) return;
        var active = CompareItems[ActiveIndex];
        var editing = EditingRowIndex is int editingIndex ? CompareItems[editingIndex] : null;
        CompareItems.RemoveAt(index);
        ActiveIndex = CompareItems.IndexOf(active);
        if (ActiveIndex < 0) ActiveIndex = Math.Min(index, CompareItems.Count - 1);
        var newEditingIndex = editing is null ? -1 : CompareItems.IndexOf(editing);
        EditingRowIndex = newEditingIndex < 0 ? null : newEditingIndex;
        if (EditingRowIndex is null) RawEditingInput = null;
        _focusAfterRemoval = Math.Min(index, CompareItems.Count - 1);
        RecalculateFromActive();
        await SavePreferencesAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_focusAfterRemoval is int index && _comparisonList is not null)
        {
            _focusAfterRemoval = null;
            await _comparisonList.FocusRowAsync(index);
        }
    }

    private async Task ToggleThemeAsync()
    {
        IsDarkMode = !IsDarkMode;
        await JS.InvokeVoidAsync("ccTheme.set", IsDarkMode ? "dark" : "light");
    }

    private void OpenSettings()
    {
        SelectorOpen = false;
        ShowSettings = true;
    }

    private void OpenAbout()
    {
        ShowSettings = false;
        ShowAbout = true;
    }

    private async Task OnNeverUseKeyboardChangedAsync(bool value)
    {
        NeverUseKeyboard = value;
        await BrowserStorageService.SetAsync(AppSettings.NeverUseKeyboardStorageKey, value);
    }

    private async Task SwitchLanguageAsync(string langCode)
    {
        if (CurrentLanguage == langCode) return;
        CurrentLanguage = langCode;
        await LocalizationService.SaveLanguageAsync(CurrentLanguage);
        await SavePreferencesAsync();
    }

    private void ShowCryptoWarning(bool isStale)
    {
        CryptoModalMessage = isStale ? L("CryptoStaleWarning") : L("CryptoVolatileWarning");
        ShowCryptoModal = true;
    }

    private void CloseCryptoModal() => ShowCryptoModal = false;
    private void CloseAbout() => ShowAbout = false;
    private void CloseSettings() => ShowSettings = false;

    private async Task OnIgnoreFiatDecimalsChangedAsync(bool value)
    {
        IgnoreFiatDecimals = value;
        await BrowserStorageService.SetAsync(AppSettings.IgnoreFiatDecimalsStorageKey, value);
        RecalculateFromActive();
    }

    private async Task OnHideCurrencyIconsChangedAsync(bool value)
    {
        HideCurrencyIcons = value;
        await BrowserStorageService.SetAsync(AppSettings.HideCurrencyIconsStorageKey, value);
    }

    private async Task ReorderItemsAsync((int Source, int Target) move)
    {
        if (move.Source == move.Target || move.Source < 0 || move.Source >= CompareItems.Count
            || move.Target < 0 || move.Target >= CompareItems.Count)
        {
            return;
        }

        var active = CompareItems[ActiveIndex];
        var editing = EditingRowIndex is int index ? CompareItems[index] : null;
        var moved = CompareItems[move.Source];
        CompareItems.RemoveAt(move.Source);
        CompareItems.Insert(move.Target, moved);
        ActiveIndex = CompareItems.IndexOf(active);
        EditingRowIndex = editing is null ? null : CompareItems.IndexOf(editing);
        await SavePreferencesAsync();
    }

    private void RecalculateFromActive()
    {
        if (LatestSnapshot is null || CompareItems.Count == 0) return;
        ActiveIndex = Math.Clamp(ActiveIndex, 0, CompareItems.Count - 1);
        var baseItem = CompareItems[ActiveIndex];

        for (var i = 0; i < CompareItems.Count; i++)
        {
            if (i == ActiveIndex) continue;
            var item = CompareItems[i];
            if (!HasRate(baseItem.CurrencyCode) || !HasRate(item.CurrencyCode)) continue;
            var converted = ExchangeRateService.Convert(baseItem.Amount, baseItem.CurrencyCode, item.CurrencyCode, LatestSnapshot);
            var def = CurrencyCatalog.GetByCode(item.CurrencyCode);
            var decimals = GetEffectiveDecimals(def);
            item.Amount = decimal.Round(converted, decimals);
        }
    }

    private string GetDisplayAmount(CompareItemState row, CurrencyDefinition currency)
    {
        var rowIndex = CompareItems.IndexOf(row);
        if (rowIndex != ActiveIndex && !IsConversionAvailable(row)) return L("Unavailable");
        if (EditingRowIndex == rowIndex && RawEditingInput is not null)
            return RawEditingInput;
        return FormatAmountForDisplay(row.Amount, currency);
    }

    private string FormatAmountForDisplay(decimal amount, CurrencyDefinition currency)
    {
        if (amount == 0m) return "";
        var culture = GetCultureForLanguage();
        var decimals = GetEffectiveDecimals(currency);
        if (IgnoreFiatDecimals && currency.Kind == CurrencyKind.Fiat)
        {
            // Show up to 6 decimals but trim trailing zeros
            var formatted = amount.ToString($"N{decimals}", culture);
            return TrimTrailingDecimalZeros(formatted, culture.NumberFormat.NumberDecimalSeparator);
        }
        return amount.ToString($"N{decimals}", culture);
    }

    private int GetEffectiveDecimals(CurrencyDefinition currency)
    {
        if (IgnoreFiatDecimals && currency.Kind == CurrencyKind.Fiat)
            return 6;
        return currency.DisplayDecimals;
    }

    private static string TrimTrailingDecimalZeros(string formatted, string decimalSeparator)
    {
        var sepIndex = formatted.LastIndexOf(decimalSeparator, StringComparison.Ordinal);
        if (sepIndex < 0) return formatted;

        var end = formatted.Length - 1;
        while (end > sepIndex && formatted[end] == '0')
            end--;
        if (end == sepIndex)
            end -= decimalSeparator.Length; // remove the decimal separator too
        return formatted[..(end + 1)];
    }

    private static string FormatAmountRaw(decimal amount, CurrencyDefinition currency)
    {
        if (amount == 0m) return "";
        return amount.ToString(System.Globalization.CultureInfo.InvariantCulture);
    }

    private IReadOnlyList<CurrencyDefinition> GetSelectableCurrencies()
    {
        var selectedCodes = CompareItems.Select(item => item.CurrencyCode)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        return CurrencyCatalog.Items.Where(item => !selectedCodes.Contains(item.Code)).ToArray();
    }

    private async Task LoadRecentSelectorCodesAsync()
    {
        var stored = await BrowserStorageService.GetAsync<List<string>>(AppSettings.SelectorRecentStorageKey);
        RecentSelectorCodes = stored?
            .Where(code => !string.IsNullOrWhiteSpace(code) && CurrencyCatalog.IsSupported(code))
            .Select(code => code.ToUpperInvariant())
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(AppSettings.SelectorRecentMaxCount)
            .ToList() ?? [];
    }

    private async Task SaveRecentSelectorCodesAsync()
    {
        await BrowserStorageService.SetAsync(AppSettings.SelectorRecentStorageKey, RecentSelectorCodes);
    }

    private void UpdateRecentSelectorCodes(string code)
    {
        RecentSelectorCodes.RemoveAll(existing => existing.Equals(code, StringComparison.OrdinalIgnoreCase));
        RecentSelectorCodes.Insert(0, code.ToUpperInvariant());
        if (RecentSelectorCodes.Count > AppSettings.SelectorRecentMaxCount)
            RecentSelectorCodes = RecentSelectorCodes.Take(AppSettings.SelectorRecentMaxCount).ToList();
    }

    private System.Globalization.CultureInfo GetCultureForLanguage() => CurrentLanguage switch
    {
        "zh-CN" => new System.Globalization.CultureInfo("zh-CN"),
        "ja-JP" => new System.Globalization.CultureInfo("ja-JP"),
        "en-US" => new System.Globalization.CultureInfo("en-US"),
        _ => System.Globalization.CultureInfo.InvariantCulture
    };

    private bool IsConversionAvailable(CompareItemState row) =>
        HasRate(CompareItems[ActiveIndex].CurrencyCode) && HasRate(row.CurrencyCode);

    private bool HasRate(string code) => LatestSnapshot?.HasRate(code) == true;
    private string L(string key) => LocalizationService.T(CurrentLanguage, key);

    private bool IsGlobalStale()
    {
        if (LatestSnapshot is null) return false;
        return (DateTimeOffset.UtcNow - LatestSnapshot.FetchedAtUtc) > AppSettings.FiatStaleThreshold;
    }

    private bool IsCryptoStale(CurrencyDefinition currency)
    {
        if (currency.Kind != CurrencyKind.Crypto || LatestSnapshot is null) return false;
        return (DateTimeOffset.UtcNow - LatestSnapshot.FetchedAtUtc) > AppSettings.CryptoStaleThreshold;
    }

    private string GetSourceLabel() => LatestSnapshot?.SourceKind switch
    {
        ExchangeRatesSourceKind.LiveApi => L("Live"),
        ExchangeRatesSourceKind.LocalCache => L("Cache"),
        ExchangeRatesSourceKind.StaticFallback => L("Fallback"),
        _ => "-"
    };

    private async Task SavePreferencesAsync()
    {
        var preferences = new UserPreferences
        {
            Language = CurrentLanguage,
            ActiveIndex = ActiveIndex,
            Items = CompareItems
                .Select(item => new CompareItemState { CurrencyCode = item.CurrencyCode, Amount = item.Amount })
                .ToList()
        };
        await BrowserStorageService.SetAsync(AppSettings.PreferencesStorageKey, preferences);
    }

    private List<CompareItemState> EnsureValidCompareItems(List<CompareItemState> items)
    {
        var valid = items
            .Where(item => item is not null && CurrencyCatalog.IsSupported(item.CurrencyCode))
            .Take(AppSettings.MaxCompareItems)
            .Select(item => new CompareItemState { CurrencyCode = item.CurrencyCode.ToUpperInvariant(), Amount = item.Amount })
            .ToList();
        return valid.Count >= AppSettings.MinCompareItems ? valid : BuildDefaultItems(CurrentLanguage);
    }

    private List<CompareItemState> BuildDefaultItems(string language)
    {
        var defaults = LocalizationService.GetDefaultCurrencyCodes(language);
        return
        [
            new CompareItemState { CurrencyCode = defaults[0], Amount = 100m },
            new CompareItemState { CurrencyCode = defaults[1], Amount = 0m }
        ];
    }

    private static bool TryParseAmount(string? input, out decimal amount)
    {
        amount = 0m;
        if (string.IsNullOrWhiteSpace(input)) return false;
        if (MathExpressionEvaluator.TryEvaluate(input, out amount)) return true;
        return false;
    }
}
