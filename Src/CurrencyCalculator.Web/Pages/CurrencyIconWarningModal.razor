<AdaptivePanel IsOpen="IsOpen" Title="@Localize("IconWarningTitle")" CloseLabel="@Localize("Close")" OnClose="OnCancel">
    <div class="icon-warning-content">
        <p>@Localize("IconWarningText")</p>
        <div class="icon-warning-actions">
            <button class="btn btn-secondary" @onclick="OnCancel">@Localize("KeepIconsHidden")</button>
            <button class="btn btn-primary" @onclick="OnConfirm">@Localize("ConfirmShowIcons")</button>
        </div>
    </div>
</AdaptivePanel>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter, EditorRequired] public Func<string, string> Localize { get; set; } = default!;
    [Parameter, EditorRequired] public EventCallback OnCancel { get; set; }
    [Parameter, EditorRequired] public EventCallback OnConfirm { get; set; }
}
