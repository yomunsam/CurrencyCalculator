<AdaptivePanel IsOpen="IsOpen" Title="@Localize("Settings")" CloseLabel="@Localize("Close")" OnClose="OnClose">
    <div class="settings-content">
        <div class="settings-item">
            <label for="settings-language" class="settings-item-label">@Localize("Language")</label>
            <select id="settings-language" value="@CurrentLanguage" @onchange="e => OnLanguageChanged.InvokeAsync(e.Value?.ToString() ?? CurrentLanguage)">
                @foreach (var language in LocalizationService.Languages)
                {
                    <option value="@language.Code">@language.DisplayName</option>
                }
            </select>
        </div>
        <div class="settings-item">
            <div class="settings-item-text">
                <span class="settings-item-label" id="precision-label">@Localize("IgnoreFiatDecimals")</span>
                <span class="settings-item-desc">@Localize("IgnoreFiatDecimalsDesc")</span>
            </div>
            <label class="cc-toggle">
                <input type="checkbox" aria-labelledby="precision-label" checked="@IgnoreFiatDecimals" @onchange="OnToggleIgnoreFiatDecimals" />
                <span class="cc-toggle-slider"></span>
            </label>
        </div>
        <div class="settings-item">
            <div class="settings-item-text">
                <span class="settings-item-label" id="icons-label">@Localize("ShowCurrencyIcons")</span>
                <span class="settings-item-desc">@Localize("ShowCurrencyIconsDesc")</span>
            </div>
            <label class="cc-toggle" @key="_showIconWarning">
                <input type="checkbox" aria-labelledby="icons-label" checked="@(!HideCurrencyIcons)" @onchange="OnToggleHideCurrencyIcons" />
                <span class="cc-toggle-slider"></span>
            </label>
        </div>
        <div class="settings-item">
            <div class="settings-item-text">
                <span class="settings-item-label" id="keyboard-label">@Localize("NeverUseKeyboard")</span>
                <span class="settings-item-desc">@Localize("NeverUseKeyboardDesc")</span>
            </div>
            <label class="cc-toggle">
                <input type="checkbox" aria-labelledby="keyboard-label" checked="@NeverUseKeyboard" @onchange="e => OnNeverUseKeyboardChanged.InvokeAsync((bool)(e.Value ?? false))" />
                <span class="cc-toggle-slider"></span>
            </label>
        </div>
        <button class="settings-link" @onclick="OnAbout"><i class="bi bi-info-circle"></i> @Localize("AboutTitle") · @Localize("AboutDataSources") <i class="bi bi-chevron-right"></i></button>
    </div>
</AdaptivePanel>

<CurrencyIconWarningModal IsOpen="_showIconWarning" Localize="Localize" OnCancel="OnIconWarningCancel" OnConfirm="OnIconWarningConfirm" />

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IgnoreFiatDecimals { get; set; }
    [Parameter] public bool HideCurrencyIcons { get; set; }
    [Parameter] public bool IsChinaTimezone { get; set; }
    [Parameter, EditorRequired] public Func<string, string> Localize { get; set; } = null!;
    [Parameter, EditorRequired] public EventCallback OnClose { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> OnIgnoreFiatDecimalsChanged { get; set; }
    [Parameter, EditorRequired] public EventCallback<bool> OnHideCurrencyIconsChanged { get; set; }

    [Parameter] public string CurrentLanguage { get; set; } = "en-US";
    [Parameter] public bool NeverUseKeyboard { get; set; }
    [Parameter] public EventCallback<string> OnLanguageChanged { get; set; }
    [Parameter] public EventCallback<bool> OnNeverUseKeyboardChanged { get; set; }
    [Parameter] public EventCallback OnAbout { get; set; }
    private bool _showIconWarning;

    private async Task OnToggleIgnoreFiatDecimals(ChangeEventArgs e)
    {
        var value = (bool)(e.Value ?? false);
        await OnIgnoreFiatDecimalsChanged.InvokeAsync(value);
    }

    private async Task OnToggleHideCurrencyIcons(ChangeEventArgs e)
    {
        var value = !(bool)(e.Value ?? false);
        // 显示图标前保留当地时区的告知确认。
        if (!value && IsChinaTimezone)
        {
            _showIconWarning = true;
            return;
        }
        await OnHideCurrencyIconsChanged.InvokeAsync(value);
    }

    private void OnIconWarningCancel()
    {
        _showIconWarning = false;
        // 取消后保持原设置。
    }

    private async Task OnIconWarningConfirm()
    {
        _showIconWarning = false;
        await OnHideCurrencyIconsChanged.InvokeAsync(false);
    }
}
